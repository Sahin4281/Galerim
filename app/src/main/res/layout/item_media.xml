<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="1dp">

    <ImageView
        android:id="@+id/mediaThumbnail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:scaleType="centerCrop" />

    <TextureView
        android:id="@+id/mediaTextureView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/videoInfoPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/mediaThumbnail"
        app:layout_constraintEnd_toEndOf="@+id/mediaThumbnail"
        android:layout_margin="4dp"
        android:background="#88000000"
        android:padding="2dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/videoDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/daysLeftContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/mediaThumbnail"
        app:layout_constraintStart_toStartOf="@+id/mediaThumbnail"
        android:layout_margin="4dp"
        android:background="#88000000"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/tvDaysLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/selectionOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@+id/mediaThumbnail"
        app:layout_constraintBottom_toBottomOf="@+id/mediaThumbnail"
        app:layout_constraintStart_toStartOf="@+id/mediaThumbnail"
        app:layout_constraintEnd_toEndOf="@+id/mediaThumbnail"
        android:background="#66000000"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/selectionCheck"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="6dp"
        app:layout_constraintTop_toTopOf="@+id/mediaThumbnail"
        app:layout_constraintStart_toStartOf="@+id/mediaThumbnail"
        android:src="@drawable/ic_check_circle_off"
        android:visibility="gone" />
</androidx.constraintlayout.widget.ConstraintLayout>
