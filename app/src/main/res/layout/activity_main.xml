<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/p_app_background">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinatorLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomBarsContainer">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/p_app_background"
            android:stateListAnimator="@null"
            app:elevation="0dp">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_scrollFlags="scroll|enterAlways">

                <LinearLayout
                    android:id="@+id/topIconsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_collapseMode="pin">

                    <TextView
                        android:id="@+id/mainTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Fotoğraflar"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="@color/p_app_text_primary"
                        android:paddingStart="16dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingEnd="8dp">

                        <ImageView
                            android:id="@+id/btnMainSearch"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:padding="10dp"
                            android:src="@drawable/ic_search_custom"
                            app:tint="@color/p_app_icon_tint"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"/>

                        <ImageView
                            android:id="@+id/btnMainMore"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:padding="10dp"
                            android:src="@drawable/ic_action_more"
                            app:tint="@color/p_app_icon_tint"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/searchContainer"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:layout_gravity="top"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@color/p_app_background"
                    android:visibility="gone"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    app:layout_collapseMode="pin">

                    <ImageView
                        android:id="@+id/btnSearchBack"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="12dp"
                        android:src="?attr/homeAsUpIndicator"
                        app:tint="@color/p_app_icon_tint"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"/>

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Ara..."
                        android:textColor="@color/p_app_text_primary"
                        android:textColorHint="@color/p_app_text_secondary"
                        android:textSize="18sp"
                        android:singleLine="true"
                        android:imeOptions="actionSearch"
                        android:layout_marginStart="8dp"/>

                    <ImageView
                        android:id="@+id/btnClearSearch"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="14dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        app:tint="@color/p_app_icon_tint"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone"/>
                </LinearLayout>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/allRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="2dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/albumsRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="2dp"
            android:visibility="gone"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/fastScrollBubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@+id/fastScrollContainer"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="70dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="18dp"
        app:cardBackgroundColor="@color/p_app_accent"
        app:cardElevation="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/fastScrollBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:maxLines="1" />
    </androidx.cardview.widget.CardView>

    <RelativeLayout
        android:id="@+id/fastScrollContainer"
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:layout_above="@id/bottomBarsContainer"
        android:layout_marginTop="70dp"
        android:layout_marginBottom="16dp"
        android:alpha="0">

        <View
            android:id="@+id/fastScrollThumb"
            android:layout_width="5dp"
            android:layout_height="64dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="6dp" />
    </RelativeLayout>

    <FrameLayout
        android:id="@+id/topBarsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <RelativeLayout
            android:id="@+id/favoritesTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:visibility="gone"
            android:background="@color/p_app_background"
            android:elevation="4dp">
            
            <LinearLayout
                android:id="@+id/btnBackFromFavorites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Favoriler"
                    android:textColor="@color/p_app_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:drawablePadding="12dp"
                    app:drawableStartCompat="?attr/homeAsUpIndicator"
                    app:drawableTint="@color/p_app_icon_tint" />
            </LinearLayout>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/trashTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:visibility="gone"
            android:background="@color/p_app_background"
            android:elevation="4dp">
            
            <LinearLayout
                android:id="@+id/btnBackFromTrash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Çöp Kutusu"
                    android:textColor="@color/p_app_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:drawablePadding="12dp"
                    app:drawableStartCompat="?attr/homeAsUpIndicator"
                    app:drawableTint="@color/p_app_icon_tint" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTrashTitleCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/btnBackFromTrash"
                android:textColor="@color/p_app_text_secondary"
                android:textSize="13sp"
                android:layout_marginStart="36dp"
                android:layout_marginTop="4dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <TextView
                    android:id="@+id/btnTrashEdit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Düzenle"
                    android:textColor="@color/p_app_text_primary"
                    android:textSize="16sp"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"/>
                    
                <ImageView
                    android:id="@+id/btnTrashMore"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_action_more"
                    app:tint="@color/p_app_icon_tint"
                    android:padding="4dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/selectionTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:visibility="gone"
            android:background="@color/p_app_background"
            android:elevation="4dp">

            <ImageView
                android:id="@+id/btnCloseSelection"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="?attr/homeAsUpIndicator"
                app:tint="@color/p_app_icon_tint"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tvSelectionCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btnCloseSelection"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:text="1 seçili"
                android:textColor="@color/p_app_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btnSelectAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tümü"
                    android:textColor="@color/p_app_text_primary"
                    android:textSize="16sp"
                    android:layout_marginEnd="8dp"/>
                    
                <ImageView
                    android:id="@+id/ivSelectAllIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check_circle_off"
                    app:tint="@color/p_app_icon_tint" />
            </LinearLayout>
        </RelativeLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/bottomBarsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/bottomTabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/p_app_background"
            app:tabIndicatorHeight="0dp"
            app:tabMode="fixed"
            app:tabGravity="fill"
            android:elevation="8dp"/>

        <LinearLayout
            android:id="@+id/selectionBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/p_app_background"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:baselineAligned="false"
            android:visibility="gone"
            android:elevation="10dp">

            <LinearLayout
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:id="@+id/ivShareIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_action_share" />
                <TextView
                    android:id="@+id/tvShareText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paylaş"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnRestore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/ivRestoreIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_undo"
                    app:tint="#4CAF50" />
                <TextView
                    android:id="@+id/tvRestoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Geri Yükle"
                    android:textSize="12sp"
                    android:textColor="#4CAF50"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:id="@+id/ivDeleteIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_action_delete" />
                <TextView
                    android:id="@+id/tvDeleteText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sil"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnMore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:id="@+id/ivMoreIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_action_more" />
                <TextView
                    android:id="@+id/tvMoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daha Fazla"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/emptyTrashView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resim veya video yok"
            android:textColor="@color/p_app_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sildiğiniz tüm görüntü veya videolar, kalıcı olarak silinmeden önce 30 gün boyunca Çöp kutusunda kalır."
            android:textColor="@color/p_app_text_secondary"
            android:textSize="14sp"
            android:textAlignment="center"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/emptyFavoritesView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Burası boş"
            android:textColor="@color/p_app_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Favori fotoğraf ve videolarınızı burada hızlıca bulabilmeniz için, fotoğraf ve videolarda ki kalp simgesine dokunun."
            android:textColor="@color/p_app_text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/emptySearchView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sonuç bulunamadı"
            android:textColor="@color/p_app_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>
