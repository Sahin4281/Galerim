<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/p_app_background"
    android:id="@+id/rootLayout">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="?android:attr/windowBackground"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_action_close"
            app:tint="@color/p_app_icon_tint"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alan Açıcı"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/p_app_text_primary"
            android:layout_marginStart="16dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/loadingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_below="@id/topBar">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/p_app_icon_tint"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kopya ve benzer fotoğraflar taranıyor..."
            android:textColor="@color/p_app_text_secondary"
            android:layout_marginTop="16dp"
            android:textSize="16sp"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerDuplicates"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@id/bottomBar"
        android:clipToPadding="false"
        android:padding="8dp"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="?android:attr/windowBackground"
        android:elevation="8dp"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSelectedSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 MB seçili"
            android:textColor="@color/p_app_text_primary"
            android:gravity="center"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDeleteSelected"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Seçilenleri Sil"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_danger"
            android:textAllCaps="false"
            android:textSize="16sp"/>
    </LinearLayout>
</RelativeLayout>
